<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Jellyfin.Plugin.JellyPlay</RootNamespace>
    <AssemblyVersion>0.11.3.1</AssemblyVersion>
    <FileVersion>0.11.3.1</FileVersion>
    <Version>0.11.3.1</Version>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="10.11.*-*" ExcludeAssets="runtime" />
    <PackageReference Include="Jellyfin.Model" Version="10.11.*-*" ExcludeAssets="runtime" />
    <!-- Host-provided at runtime (stripped from the artifact by build.sh); compile-only for the camelCase output formatter -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
    <!-- GHSA-2m69-gcr7-jv3q: pin the transitive native sqlite above the vulnerable 2.1.11 -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.12" />
    <PackageReference Include="YamlDotNet" Version="16.2.0" />
    <!-- SMTP for the newsletter; System.Net.Mail.SmtpClient is deprecated. Not host-provided: build.sh must ship these DLLs. -->
    <PackageReference Include="MailKit" Version="4.18.1" />
    <PackageReference Include="MimeKit" Version="4.18.1" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Jellyfin.Plugin.JellyPlay.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Pages\**\*" />
    <EmbeddedResource Include="Pages\**\*" />
    <!-- Generated by the client (./gradlew :shared:core:datastore:generateSettingsCatalog);
         served at GET jellyplay/settings/catalog and validated at load. -->
    <EmbeddedResource Include="Resources\jellyplay-settings-catalog.json" />
  </ItemGroup>

</Project>
